t2p_mktemp_list() {
    util_mktemp list
}

# =============================================================================
# t2p_for_each_child() - Print child directory basenames of one parent
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_for_each_child() {
    _parent="${1:-}"
    [ -n "${_parent}" ] && [ -d "${_parent}" ] || return 0
    for _d in "${_parent}"/*; do
        [ -d "${_d}" ] || continue
        _base="${_d##*/}"
        case "${_base}" in
            .*|lost+found) continue ;;
        esac
        printf '%s\n' "${_base}"
    done
}

# =============================================================================
# t2p_list_count() - Count non-empty lines in a list file
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_list_count() {
    _file="${1:-}"
    _c=0
    if [ -n "${_file}" ] && [ -f "${_file}" ]; then
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            [ -n "${_ln}" ] || continue
            _c=$((_c + 1))
        done < "${_file}"
    fi
    printf '%s' "${_c}"
}

# =============================================================================
# t2p_build_template_list() - Unique genesis-shaped kits (RAM-first)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_build_template_list() {
    _file="${1:-}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${HOME:=/tmp}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : > "${_file}"
    _names=$(t2p_mktemp_list)
    {
        t2p_for_each_child "${T2P_RAM_ROOT}"
        t2p_for_each_child "${PROJECTS_ROOT}"
    } | sort -u > "${_names}"
    while IFS= read -r _base || [ -n "${_base}" ]; do
        [ -n "${_base}" ] || continue
        if t2p_resolve_root "${_base}"; then
            if t2p_is_genesis_shaped "${T2P_RESOLVED_ROOT}"; then
                if ! t2p_refuse_path "${T2P_RESOLVED_ROOT}"; then
                    printf '%s|%s|%s\n' "${_base}" "${T2P_LAST_HOST_VERSION}" "${T2P_RESOLVED_ROOT}" >> "${_file}"
                fi
            fi
        fi
    done < "${_names}"
    rm -f "${_names}"
}

# =============================================================================
# t2p_build_project_list() - Current folder (if a project) then ~/prjs (+ RAM)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_build_project_list() {
    _file="${1:-}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${HOME:=/tmp}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : > "${_file}"
    _cwd=$(pwd 2>/dev/null || printf '%s' ".")
    if ! t2p_refuse_path "${_cwd}"; then
        if t2p_is_project_shaped "${_cwd}"; then
            _cb="${_cwd##*/}"
            printf '%s|current-folder|%s\n' "${_cb}" "${_cwd}" >> "${_file}"
        fi
    fi
    _names=$(t2p_mktemp_list)
    {
        t2p_for_each_child "${T2P_RAM_ROOT}"
        t2p_for_each_child "${PROJECTS_ROOT}"
    } | sort -u > "${_names}"
    while IFS= read -r _base || [ -n "${_base}" ]; do
        [ -n "${_base}" ] || continue
        if t2p_resolve_root "${_base}"; then
            if t2p_is_project_shaped "${T2P_RESOLVED_ROOT}"; then
                if t2p_refuse_path "${T2P_RESOLVED_ROOT}"; then
                    continue
                fi
                if [ "${T2P_RESOLVED_ROOT}" = "${_cwd}" ]; then
                    continue
                fi
                printf '%s|%s|%s\n' "${_base}" "${T2P_LAST_HOST_VERSION}" "${T2P_RESOLVED_ROOT}" >> "${_file}"
            fi
        fi
    done < "${_names}"
    rm -f "${_names}"
}

# =============================================================================
# t2p_picker_back_number() - All-nines back number strictly greater than N
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_picker_back_number() {
    _n="${1:-0}"
    if [ "${_n}" -le 8 ]; then
        printf '9'
    elif [ "${_n}" -le 98 ]; then
        printf '99'
    else
        printf '999'
    fi
}

# =============================================================================
# t2p_pick_is_back() - 0 always; all-nines when strictly greater than item count
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_pick_is_back() {
    _pick="${1:-}"
    _n="${2:-0}"
    case "${_pick}" in
        0|exit|quit|Exit|QUIT|back)
            return 0
            ;;
    esac
    _back=$(t2p_picker_back_number "${_n}")
    if [ "${_pick}" = "${_back}" ]; then
        return 0
    fi
    return 1
}


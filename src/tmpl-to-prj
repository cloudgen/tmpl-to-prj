# =============================================================================
# t2p_grant_has_backup_star() - Text contains backup *
# =============================================================================
t2p_grant_has_backup_star() {
    : "${FOLDER_BACKUP_NAME:=folder-backup}"
    printf '%s\n' "${1:-}" | grep -qE "${FOLDER_BACKUP_NAME}[[:space:]]+backup[[:space:]]+\\*"
}

# =============================================================================
# t2p_grant_has_verb_only_backup() - Text ends a Cmnd at backup (no *)
# =============================================================================
t2p_grant_has_verb_only_backup() {
    : "${FOLDER_BACKUP_NAME:=folder-backup}"
    printf '%s\n' "${1:-}" | grep -qE "${FOLDER_BACKUP_NAME}[[:space:]]+backup[[:space:]]*$"
}

# =============================================================================
# t2p_sudoers_allows_backup_star() - Exact argv match for backup *
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - INC-20260902-001
#
# Last updated: 2026-09-02
# =============================================================================
t2p_sudoers_allows_backup_star() {
    : "${FOLDER_BACKUP_NAME:=folder-backup}"
    : "${T2P_SUDOERS_FILE:=}"
    : "${T2P_SUDOERS_D_DIR:=}"
    T2P_FB_NOPASSWD=0
    T2P_FB_VERB_ONLY=0
    _had_star=0
    while IFS= read -r _sf || [ -n "${_sf}" ]; do
        [ -n "${_sf}" ] || continue
        [ -f "${_sf}" ] && [ -r "${_sf}" ] || continue
        _body=$(cat "${_sf}" 2>/dev/null || true)
        if t2p_grant_has_backup_star "${_body}"; then
            _had_star=1
            if printf '%s\n' "${_body}" | grep -qE "NOPASSWD:.*${FOLDER_BACKUP_NAME}[[:space:]]+backup[[:space:]]+\\*"; then
                T2P_FB_NOPASSWD=1
            fi
        elif t2p_grant_has_verb_only_backup "${_body}"; then
            T2P_FB_VERB_ONLY=1
        fi
    done <<EOF
$(t2p_sudoers_candidate_list)
EOF
    if [ "${_had_star}" -eq 1 ]; then
        T2P_FB_VERB_ONLY=0
        export T2P_FB_NOPASSWD T2P_FB_VERB_ONLY
        return 0
    fi
    if [ -z "${T2P_SUDOERS_FILE}" ] && [ -z "${T2P_SUDOERS_D_DIR}" ] && command -v sudo >/dev/null 2>&1; then
        _lst=$(sudo -n -l 2>/dev/null || true)
        if t2p_grant_has_backup_star "${_lst}"; then
            if printf '%s\n' "${_lst}" | grep -qE "NOPASSWD:.*${FOLDER_BACKUP_NAME}[[:space:]]+backup[[:space:]]+\\*"; then
                T2P_FB_NOPASSWD=1
            fi
            T2P_FB_VERB_ONLY=0
            export T2P_FB_NOPASSWD T2P_FB_VERB_ONLY
            return 0
        fi
        if t2p_grant_has_verb_only_backup "${_lst}"; then
            T2P_FB_VERB_ONLY=1
        fi
    fi
    export T2P_FB_NOPASSWD T2P_FB_VERB_ONLY
    return 1
}

# =============================================================================
# t2p_folder_backup_gate() - missing | narrow | unproven | pass
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - INC-20260902-001
#
# Last updated: 2026-09-02
# =============================================================================
t2p_folder_backup_gate() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    T2P_FB_NOPASSWD=0
    T2P_FB_VERB_ONLY=0
    if util_is_normal_user_only_cli; then
        T2P_FB_GATE="missing"
        export T2P_FB_GATE T2P_FB_NOPASSWD T2P_FB_VERB_ONLY
        return 0
    fi
    _bin=$(t2p_folder_backup_bin)
    if [ ! -x "${_bin}" ] || ! "${_bin}" version >/dev/null 2>&1; then
        T2P_FB_GATE="missing"
        export T2P_FB_GATE T2P_FB_NOPASSWD T2P_FB_VERB_ONLY
        return 0
    fi
    if t2p_sudoers_allows_backup_star; then
        T2P_FB_GATE="pass"
        export T2P_FB_GATE
        return 0
    fi
    if [ "${T2P_FB_VERB_ONLY}" -eq 1 ]; then
        T2P_FB_GATE="narrow"
        export T2P_FB_GATE
        return 0
    fi
    if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
        T2P_FB_GATE="pass"
        export T2P_FB_GATE
        return 0
    fi
    T2P_FB_GATE="unproven"
    export T2P_FB_GATE
    return 0
}

# =============================================================================
# t2p_refuse_path() - Hard refuse home / root / mount roots
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_refuse_path() {
    _p="${1:-}"
    : "${HOME:=/tmp}"
    [ -n "${_p}" ] || return 0
    case "${_p}" in
        /|/home|"${HOME}"|/dev|/dev/shm|"${T2P_RAM_ROOT:-/dev/shm}")
            return 0
            ;;
    esac
    return 1
}

# =============================================================================
# t2p_resolve_root() - RAM-drive first; print absolute root
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_resolve_root() {
    _name="${1:-}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${HOME:=/tmp}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    T2P_LAST_HOST_VERSION=""
    T2P_RESOLVED_ROOT=""
    [ -n "${_name}" ] || return 1
    case "${_name}" in
        /*)
            if [ -d "${_name}" ]; then
                T2P_LAST_HOST_VERSION="explicit-path"
                T2P_RESOLVED_ROOT="${_name}"
                export T2P_LAST_HOST_VERSION T2P_RESOLVED_ROOT
                return 0
            fi
            return 1
            ;;
    esac
    if [ -d "${T2P_RAM_ROOT}/${_name}" ]; then
        T2P_LAST_HOST_VERSION="ram-drive"
        T2P_RESOLVED_ROOT="${T2P_RAM_ROOT}/${_name}"
        export T2P_LAST_HOST_VERSION T2P_RESOLVED_ROOT
        return 0
    fi
    if [ -d "${PROJECTS_ROOT}/${_name}" ]; then
        T2P_LAST_HOST_VERSION="hard-disk"
        T2P_RESOLVED_ROOT="${PROJECTS_ROOT}/${_name}"
        export T2P_LAST_HOST_VERSION T2P_RESOLVED_ROOT
        return 0
    fi
    return 1
}

# =============================================================================
# t2p_count_requirements() - Count dest/template requirement-*.md
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_count_requirements() {
    _root="${1:-}"
    _c=0
    for _f in "${_root}/docs/requirements"/requirement-*.md; do
        if [ -f "${_f}" ]; then
            _c=$((_c + 1))
        fi
    done
    printf '%s' "${_c}"
}

# =============================================================================
# t2p_count_non_readme_files() - Count files in a dir other than README.md
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_count_non_readme_files() {
    _dir="${1:-}"
    _c=0
    [ -n "${_dir}" ] && [ -d "${_dir}" ] || {
        printf '0'
        return 0
    }
    for _f in "${_dir}"/*; do
        [ -f "${_f}" ] || continue
        _b="${_f##*/}"
        case "${_b}" in
            README.md|README|readme.md|README.MD) continue ;;
        esac
        _c=$((_c + 1))
    done
    printf '%s' "${_c}"
}

# =============================================================================
# t2p_is_genesis_shaped() - Unspecialized kit: docs/, 0 REQs, no incidents, no tests
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_is_genesis_shaped() {
    _root="${1:-}"
    [ -d "${_root}/docs" ] || return 1
    _n=$(t2p_count_requirements "${_root}")
    [ "${_n}" -eq 0 ] || return 1
    _inc=$(t2p_count_non_readme_files "${_root}/docs/incidents")
    [ "${_inc}" -eq 0 ] || return 1
    _tests=$(t2p_count_non_readme_files "${_root}/tests")
    [ "${_tests}" -eq 0 ] || return 1
    return 0
}


t2p_report_resolve() {
    : "${JSON:=0}"
    : "${T2P_FB_GATE:=}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "plan" "" \
            "app" "${APP_NAME}" \
            "template_name" "${TEMPLATE_NAME}" \
            "project_name" "${PROJECT_NAME}" \
            "template_root" "${T2P_SRC_ROOT}" \
            "template_host" "${T2P_SRC_HOST}" \
            "project_root" "${T2P_DST_ROOT}" \
            "project_host" "${T2P_DST_HOST}" \
            "folder_backup_gate" "${T2P_FB_GATE}" \
            "dest_requirements" "$(t2p_count_requirements "${T2P_DST_ROOT}")"
        return 0
    fi
    out_info "Template: ${TEMPLATE_NAME}"
    out_info "  root: ${T2P_SRC_ROOT}"
    out_info "  host: ${T2P_SRC_HOST}"
    out_info "Project: ${PROJECT_NAME}"
    out_info "  root: ${T2P_DST_ROOT}"
    out_info "  host: ${T2P_DST_HOST}"
    out_info "folder-backup gate: ${T2P_FB_GATE}"
    out_info "Dest requirement files: $(t2p_count_requirements "${T2P_DST_ROOT}")"

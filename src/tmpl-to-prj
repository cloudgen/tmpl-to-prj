t2p_pick_project() {
    : "${APP_NAME:=tmpl-to-prj}"
    _file=$(t2p_mktemp_list)
    t2p_build_project_list "${_file}"
    _n=$(t2p_list_count "${_file}")
    if [ "${_n}" -eq 0 ]; then
        rm -f "${_file}"
        out_die "No project folder found (current directory or ${PROJECTS_ROOT}). Next: ${APP_NAME} apply --template NAME --project NAME"
    fi
    t2p_print_picker "Choose a project (current folder and ${PROJECTS_ROOT})" "${_file}" 1
    t2p_read_pick "${_file}" "${_n}"
    rm -f "${_file}"
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        TEMPLATE_NAME=""
        PROJECT_NAME=""
        export TEMPLATE_NAME PROJECT_NAME
        return 1
    fi
    if [ "${T2P_PICKED_HOST}" = "current-folder" ]; then
        PROJECT_NAME="${T2P_PICKED_ROOT}"
    else
        PROJECT_NAME="${T2P_PICKED_NAME}"
    fi
    export PROJECT_NAME
    return 0
}


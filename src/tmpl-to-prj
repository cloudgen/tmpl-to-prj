# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_list_count() {
    _file="${1:-}"
    _c=0
    if [ -n "${_file}" ] && [ -f "${_file}" ]; then
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            [ -n "${_ln}" ] || continue
            _c=$((_c + 1))
        done < "${_file}"
    fi
    printf '%s' "${_c}"
}

# =============================================================================
# t2p_build_template_list() - Unique genesis-shaped kits (RAM-first)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_build_template_list() {
    _file="${1:-}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${HOME:=/tmp}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : > "${_file}"
    _names=$(t2p_mktemp_list)
    {
        t2p_for_each_child "${T2P_RAM_ROOT}"
        t2p_for_each_child "${PROJECTS_ROOT}"
    } | sort -u > "${_names}"
    while IFS= read -r _base || [ -n "${_base}" ]; do
        [ -n "${_base}" ] || continue
        if t2p_resolve_root "${_base}"; then
            if t2p_is_genesis_shaped "${T2P_RESOLVED_ROOT}"; then
                if ! t2p_refuse_path "${T2P_RESOLVED_ROOT}"; then
                    printf '%s|%s|%s\n' "${_base}" "${T2P_LAST_HOST_VERSION}" "${T2P_RESOLVED_ROOT}" >> "${_file}"
                fi
            fi
        fi
    done < "${_names}"
    rm -f "${_names}"
}

# =============================================================================
# t2p_build_project_list() - Current folder (if a project) then ~/prjs (+ RAM)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_build_project_list() {
    _file="${1:-}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${HOME:=/tmp}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : > "${_file}"
    _cwd=$(pwd 2>/dev/null || printf '%s' ".")
    if ! t2p_refuse_path "${_cwd}"; then
        if t2p_is_project_shaped "${_cwd}"; then
            _cb="${_cwd##*/}"
            printf '%s|current-folder|%s\n' "${_cb}" "${_cwd}" >> "${_file}"
        fi
    fi
    _names=$(t2p_mktemp_list)
    {
        t2p_for_each_child "${T2P_RAM_ROOT}"
        t2p_for_each_child "${PROJECTS_ROOT}"
    } | sort -u > "${_names}"
    while IFS= read -r _base || [ -n "${_base}" ]; do
        [ -n "${_base}" ] || continue
        if t2p_resolve_root "${_base}"; then
            if t2p_is_project_shaped "${T2P_RESOLVED_ROOT}"; then
                if t2p_refuse_path "${T2P_RESOLVED_ROOT}"; then
                    continue
                fi
                if [ "${T2P_RESOLVED_ROOT}" = "${_cwd}" ]; then
                    continue
                fi
                printf '%s|%s|%s\n' "${_base}" "${T2P_LAST_HOST_VERSION}" "${T2P_RESOLVED_ROOT}" >> "${_file}"
            fi
        fi
    done < "${_names}"
    rm -f "${_names}"
}

# =============================================================================
# t2p_picker_back_number() - All-nines back number strictly greater than N
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_picker_back_number() {
    _n="${1:-0}"
    if [ "${_n}" -le 8 ]; then
        printf '9'
    elif [ "${_n}" -le 98 ]; then
        printf '99'
    else
        printf '999'
    fi
}

# =============================================================================
# t2p_pick_is_back() - 0 always; all-nines when strictly greater than item count
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_pick_is_back() {
    _pick="${1:-}"
    _n="${2:-0}"
    case "${_pick}" in
        0|exit|quit|Exit|QUIT|back)
            return 0
            ;;
    esac
    _back=$(t2p_picker_back_number "${_n}")
    if [ "${_pick}" = "${_back}" ]; then
        return 0
    fi
    return 1
}

# =============================================================================
# t2p_print_picker() - Numbered human list; optional single 0 back row
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_print_picker() {
    _title="${1:-Choose}"
    _file="${2:-}"
    _show_back="${3:-0}"
    : "${JSON:=0}"
    out_info "${_title}"
    _n=0
    while IFS='|' read -r _name _host _root || [ -n "${_name}" ]; do
        [ -n "${_name}" ] || continue
        _n=$((_n + 1))
        out_plain "${_n}. ${_name}: ${_host}  ${_root}"
    done < "${_file}"
    if [ "${_n}" -eq 0 ]; then
        out_warn "No matching folders."
    fi
    if [ "${_show_back}" -eq 1 ]; then
        out_plain "0. Back to main menu"
    fi
}

# =============================================================================
# t2p_nth_list_line() - Return line N (1-based) from a list file
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_nth_list_line() {
    _file="${1:-}"
    _want="${2:-0}"
    _n=0
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -n "${_ln}" ] || continue
        _n=$((_n + 1))
        if [ "${_n}" -eq "${_want}" ]; then
            printf '%s' "${_ln}"
            return 0
        fi
    done < "${_file}"
    return 1
}

# =============================================================================
# t2p_read_pick() - Read a number or basename; set T2P_PICKED_* or cancel
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_read_pick() {
    _file="${1:-}"
    _n="${2:-0}"
    : "${APP_NAME:=tmpl-to-prj}"
    T2P_PICKED_NAME=""
    T2P_PICKED_HOST=""
    T2P_PICKED_ROOT=""
    T2P_PICK_CANCEL=0
    export T2P_PICK_CANCEL
    while true; do
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            T2P_PICK_CANCEL=1
            export T2P_PICK_CANCEL
            return 0
        fi
        if t2p_pick_is_back "${_pick}" "${_n}"; then
            T2P_PICK_CANCEL=1
            export T2P_PICK_CANCEL
            return 0
        fi
        if [ -z "${_pick}" ]; then
            out_warn "Not a list choice. Type a number, 0 to return to the main menu, or a listed name."
            continue
        fi
        _line=""
        case "${_pick}" in
            *[!0-9]*)
                while IFS='|' read -r _name _host _root || [ -n "${_name}" ]; do
                    [ -n "${_name}" ] || continue
                    if [ "${_name}" = "${_pick}" ]; then
                        _line="${_name}|${_host}|${_root}"
                        break
                    fi
                done < "${_file}"
                ;;
            *)
                _line=$(t2p_nth_list_line "${_file}" "${_pick}") || true
                ;;
        esac
        if [ -n "${_line}" ]; then
            T2P_PICKED_NAME="${_line%%|*}"
            _rest="${_line#*|}"
            T2P_PICKED_HOST="${_rest%%|*}"
            T2P_PICKED_ROOT="${_rest#*|}"
            export T2P_PICKED_NAME T2P_PICKED_HOST T2P_PICKED_ROOT
            return 0
        fi
        out_warn "Not a list choice (${_pick}). Type a number, 0 to return to the main menu, or a listed name."
    done
}

# =============================================================================
# t2p_pick_template() - TTY numbered list of unspecialized kits
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_pick_template() {
    : "${APP_NAME:=tmpl-to-prj}"
    _file=$(t2p_mktemp_list)
    t2p_build_template_list "${_file}"
    _n=$(t2p_list_count "${_file}")
    if [ "${_n}" -eq 0 ]; then
        rm -f "${_file}"
        out_die "No genesis-template (or subclass) found under ${T2P_RAM_ROOT} or ${PROJECTS_ROOT}. Next: ${APP_NAME} apply --template NAME --project NAME"
    fi
    t2p_print_picker "Choose a template (genesis-template or subclass; unspecialized kit)" "${_file}" 1
    t2p_read_pick "${_file}" "${_n}"
    rm -f "${_file}"
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        TEMPLATE_NAME=""
        PROJECT_NAME=""
        export TEMPLATE_NAME PROJECT_NAME
        return 1
    fi
    TEMPLATE_NAME="${T2P_PICKED_NAME}"
    export TEMPLATE_NAME
    return 0
}

# =============================================================================
# t2p_pick_project() - TTY numbered list: current folder then ~/prjs
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_pick_project() {
    : "${APP_NAME:=tmpl-to-prj}"
    _file=$(t2p_mktemp_list)
    t2p_build_project_list "${_file}"
    _n=$(t2p_list_count "${_file}")
    if [ "${_n}" -eq 0 ]; then
        rm -f "${_file}"
        out_die "No project folder found (current directory or ${PROJECTS_ROOT}). Next: ${APP_NAME} apply --template NAME --project NAME"
    fi
    t2p_print_picker "Choose a project (current folder and ${PROJECTS_ROOT})" "${_file}" 1
    t2p_read_pick "${_file}" "${_n}"
    rm -f "${_file}"
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        TEMPLATE_NAME=""
        PROJECT_NAME=""
        export TEMPLATE_NAME PROJECT_NAME
        return 1
    fi
    if [ "${T2P_PICKED_HOST}" = "current-folder" ]; then
        PROJECT_NAME="${T2P_PICKED_ROOT}"
    else
        PROJECT_NAME="${T2P_PICKED_NAME}"
    fi
    export PROJECT_NAME
    return 0
}


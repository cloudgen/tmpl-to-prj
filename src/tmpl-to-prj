    return 0
}

# =============================================================================
# util_sudo() - Sole in-tool sudo call site
# =============================================================================
#
# GENERAL PURPOSE:
# Wrap sudo for the folder-backup backup argv. Skip sudo when already root
# or when T2P_BACKUP_NOSUDO=1 (fixture). Matching NOPASSWD uses sudo -n.
# On a command line for normal user only (Termux / Git Bash / Windows cmd):
# MUST NOT invoke sudo.
#
# ALIGNMENT:
# - requirement-shell-sudo-command.md
# - requirement-shell-termux-ish.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-06
# =============================================================================
util_sudo() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${T2P_BACKUP_NOSUDO:=0}"
    : "${T2P_FB_NOPASSWD:=0}"
    if util_is_normal_user_only_cli; then
        return 1
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        "$@"
        return $?
    fi
    if [ "${T2P_BACKUP_NOSUDO}" -eq 1 ]; then
        "$@"
        return $?
    fi
    command -v sudo >/dev/null 2>&1 || return 1
    if [ "${T2P_FB_NOPASSWD}" -eq 1 ]; then
        sudo -n "$@"
        return $?
    fi
    if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
        sudo "$@"
        return $?
    fi
    out_die "folder-backup backup needs a terminal for a password, or a NOPASSWD sudoers line for backup *. Next: run from a terminal, or install a matching sudoers fragment (sibling folder-backup print-sudoers)."
}


# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for tmpl-to-prj. Interactive empty argv = main menu.
# Non-interactive empty argv = self-install (not help). Domain: plan / apply / menu.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-self-install.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-10-04
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${DRY_RUN:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${APP_NAME:=tmpl-to-prj}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${TEMPLATE_NAME:=}"
    : "${PROJECT_NAME:=}"
    : "${TTY:=0}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    if [ $# -eq 0 ]; then
        if [ "${TTY}" -eq 1 ]; then
            app_default
            return 0
        fi
        # curl | sh has no command token and no TTY. That line places the CLI.
        # Help is the explicit help verb. A failed place must not exit 0.
        inst_self_install
        return $?
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --dry-run)  DRY_RUN=1; export DRY_RUN ;;
            --template)
                shift
                [ $# -gt 0 ] || out_die "--template needs a template-name. Next: ${APP_NAME} apply --template NAME --project NAME"
                TEMPLATE_NAME="$1"
                export TEMPLATE_NAME
                ;;
            --project)
                shift
                [ $# -gt 0 ] || out_die "--project needs a project-name. Next: ${APP_NAME} apply --template NAME --project NAME"
                PROJECT_NAME="$1"
                export PROJECT_NAME
                ;;
            version|about|help|install|uninstall|where-is-me|plan|apply|menu|main|list-templates|list-projects|self-install|version-check|self-update|self-uninstall)
                COMMAND="$1"
                ;;
            *)
                if [ "${COMMAND}" = "plan" ] || [ "${COMMAND}" = "apply" ]; then
                    if [ -z "${TEMPLATE_NAME}" ]; then
                        TEMPLATE_NAME="$1"
                        export TEMPLATE_NAME
                    elif [ -z "${PROJECT_NAME}" ]; then
                        PROJECT_NAME="$1"
                        export PROJECT_NAME
                    else
                        out_die "Unknown extra argument: $1. Next: '${APP_NAME} help'."
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} template=${TEMPLATE_NAME} project=${PROJECT_NAME}"

    case "${COMMAND}" in
        version)         app_version ;;
        about)           app_about ;;
        install)         inst_local_install ;;
        uninstall)       inst_local_uninstall ;;
        where-is-me)     app_where_is_me ;;
        self-install)    inst_self_install ;;
        version-check)   ver_check ;;
        self-update)     inst_self_update ;;
        self-uninstall)  inst_self_uninstall ;;
        plan)            t2p_plan ;;
        apply)           t2p_apply ;;
        menu|main)       app_default ;;
        list-templates)  t2p_cmd_list_templates ;;
        list-projects)   t2p_cmd_list_projects ;;
        help|*)          app_help ;;
    esac
}

# =============================================================================
# BOOTSTRAP
# =============================================================================
# Always invoke app_main. No basename gate (pipe-safe entry).
# Product law: requirement-shell-cli-zero-arguments.md
# Non-interactive 0-argv reaches inst_self_install inside app_main.
# =============================================================================
app_main "$@"

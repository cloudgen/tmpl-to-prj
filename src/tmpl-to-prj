# =============================================================================
# t2p_plan() - Dry-run (no dest writes)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
t2p_plan() {
    if ! t2p_preflight; then
        t2p_return_to_menu_if_cancelled || true
        return 0
    fi
    t2p_report_resolve
    if [ "${JSON}" -eq 1 ]; then
        return 0
    fi
    out_info "Plan only: no docs overlay. apply will mv dest docs/requirements aside, copy template docs, then restore dest requirements."
    if [ "${T2P_FB_GATE}" = "missing" ]; then
        out_warn "Global folder-backup is not installed. apply will take a local dest-docs snapshot. Next: sudo folder-backup install"
    fi
    if [ "${T2P_FB_GATE}" = "narrow" ]; then
        out_warn "folder-backup exists but this login's sudoers is verb-only backup (no *). apply will fail closed. Next: sibling folder-backup print-sudoers"
    fi
    if [ "${T2P_FB_GATE}" = "unproven" ]; then
        out_warn "folder-backup exists but backup * was not proven at $(t2p_sudoers_path). apply will fail closed off-TTY. Next: from a terminal run sudo $(t2p_folder_backup_bin) backup ${T2P_DST_ROOT}"
    fi
    if [ "${T2P_FB_GATE}" = "pass" ]; then
        out_info "apply will run: sudo $(t2p_folder_backup_bin) backup ${T2P_DST_ROOT}"
    fi
    out_success "Plan complete (no writes)."
}

# =============================================================================
# t2p_utc_stamp() - Timestamp for aside / snapshot names
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_utc_stamp() {
    date -u +%Y%m%d-%H%M%S 2>/dev/null || date +%Y%m%d-%H%M%S
}

# =============================================================================
# t2p_local_docs_snapshot() - Weaker dest-docs copy when global backup missing
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_local_docs_snapshot() {
    _dest="${1:-}"
    _stamp=$(t2p_utc_stamp)
    _snap="${_dest}/.t2p-docs-backup-${_stamp}"
    if [ -d "${_dest}/docs" ]; then
        cp -a "${_dest}/docs" "${_snap}" || out_die "Could not snapshot dest docs. Next: check write access on the project folder."
        T2P_BACKUP_NOTE="local:${_snap}"
        export T2P_BACKUP_NOTE
        out_warn "Local dest-docs snapshot (not a durable /var/backup archive): ${_snap}"
    else
        T2P_BACKUP_NOTE="local:none"
        export T2P_BACKUP_NOTE
    fi
}

# =============================================================================
# t2p_backup_dest() - Global folder-backup or local snapshot
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-sudo-command.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_backup_dest() {
    _dest="${1:-}"
    : "${T2P_FB_GATE:=}"
    T2P_BACKUP_NOTE=""
    if [ "${T2P_FB_GATE}" = "narrow" ]; then
        out_die "folder-backup is installed but this login's sudoers is verb-only backup (no *). Next: run sibling folder-backup print-sudoers and install a backup * line at /etc/sudoers.d/${FOLDER_BACKUP_NAME}-${USERNAME}."
    fi
    if [ "${T2P_FB_GATE}" = "unproven" ]; then
        out_die "folder-backup is installed but backup * was not proven for this login (looked at $(t2p_sudoers_path)). Next: from a terminal run sudo $(t2p_folder_backup_bin) backup ${_dest} — do not treat a missing /etc/${USERNAME}/${FOLDER_BACKUP_NAME} as verb-only."
    fi
    if [ "${T2P_FB_GATE}" = "pass" ]; then
        _bin=$(t2p_folder_backup_bin)
        out_info "Backing up dest with folder-backup: ${_dest}"
        if util_sudo "${_bin}" backup "${_dest}"; then
            T2P_BACKUP_NOTE="folder-backup:${_dest}"
            export T2P_BACKUP_NOTE
            out_success "folder-backup of dest finished."
            return 0
        fi
        out_die "folder-backup backup failed. Next: check sudoers argv (backup *) and re-run apply."
    fi
    t2p_local_docs_snapshot "${_dest}"
}

# =============================================================================
# t2p_overlay_docs() - mv requirements aside, replace docs, restore
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_overlay_docs() {
    _src="${1:-}"
    _dst="${2:-}"
    : "${HOME:=/tmp}"
    : "${EFFECTIVE_STORAGE_DIR:=${HOME}}"
    _stamp=$(t2p_utc_stamp)
    T2P_ASIDE_PATH="${EFFECTIVE_STORAGE_DIR}/t2p-requirements-${_stamp}"
    export T2P_ASIDE_PATH
    if [ -d "${_dst}/docs/requirements" ]; then
        mv "${_dst}/docs/requirements" "${T2P_ASIDE_PATH}" || out_die "Could not move dest docs/requirements aside. Next: check write access."
        out_info "Moved dest docs/requirements aside: ${T2P_ASIDE_PATH}"
    fi
    if [ -e "${_dst}/docs" ]; then
        rm -rf "${_dst}/docs" || out_die "Could not remove dest docs after saving requirements. Next: restore from ${T2P_ASIDE_PATH}."
    fi
    if [ ! -d "${_src}/docs" ]; then
        if [ -d "${T2P_ASIDE_PATH}" ]; then
            mkdir -p "${_dst}/docs"
            mv "${T2P_ASIDE_PATH}" "${_dst}/docs/requirements"
        fi
        out_die "Template has no docs/ folder. Dest requirements were restored when possible."
    fi
    cp -a "${_src}/docs" "${_dst}/docs" || {
        if [ -d "${T2P_ASIDE_PATH}" ]; then
            mkdir -p "${_dst}/docs"
            mv "${T2P_ASIDE_PATH}" "${_dst}/docs/requirements" 2>/dev/null || true
        fi
        out_die "Could not copy template docs. Dest requirements were restored when possible."
    }
    if [ -e "${_dst}/docs/requirements" ]; then
        rm -rf "${_dst}/docs/requirements"
    fi
    mkdir -p "${_dst}/docs"
    if [ -d "${T2P_ASIDE_PATH}" ]; then
        mv "${T2P_ASIDE_PATH}" "${_dst}/docs/requirements" || out_die "Copied template docs but could not restore dest requirements from ${T2P_ASIDE_PATH}."
        out_info "Restored dest docs/requirements."
    fi
}

# =============================================================================
# t2p_apply() - Backup dest, overlay harness docs, keep dest requirements
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_apply() {
    : "${FORCE:=0}"
    : "${DRY_RUN:=0}"
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    if [ "${DRY_RUN}" -eq 1 ]; then
        t2p_plan
        return 0
    fi
    if ! t2p_preflight; then
        t2p_return_to_menu_if_cancelled || true
        return 0
    fi
    if [ "${JSON}" -ne 1 ]; then
        t2p_report_resolve
    fi
    if [ "${FORCE}" -ne 1 ]; then
        if ! prompt_yes_no "Replace dest docs from the template (keep dest docs/requirements)?"; then
            out_die "Apply cancelled. Next: re-run with --force if you meant to skip the confirm."
        fi
    fi
    t2p_backup_dest "${T2P_DST_ROOT}"
    t2p_overlay_docs "${T2P_SRC_ROOT}" "${T2P_DST_ROOT}"
    out_warn "Dest docs/README may still describe the template kit. Next: rebind dest maps (AGENTS.md live inventory) in an agent session."
    if [ "${JSON}" -eq 1 ]; then
        out_json "apply" "" \
            "app" "${APP_NAME}" \
            "template_root" "${T2P_SRC_ROOT}" \
            "project_root" "${T2P_DST_ROOT}" \
            "folder_backup_gate" "${T2P_FB_GATE}" \
            "backup" "${T2P_BACKUP_NOTE}" \
            "dest_requirements" "$(t2p_count_requirements "${T2P_DST_ROOT}")"
        return 0
    fi
    out_success "Apply complete: harness docs from ${TEMPLATE_NAME} onto ${PROJECT_NAME}; dest requirements kept."
}

# =============================================================================
# app_default_print_menu() - Numbered main-menu list (TTY)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
app_default_print_menu() {
    : "${APP_NAME:=tmpl-to-prj}"
    : "${VERSION:=1.0.0}"
    out_info "$(util_app_ident) — numbered list of live commands"
    out_plain "1. plan: Show template and project roots (no writes)"
    out_plain "2. apply: Copy harness docs from the template into the project"
    out_plain "9. Exit"
}

# =============================================================================
# app_default_run_pick() - Run one main-menu choice
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
app_default_run_pick() {
    _pick="${1:-}"
    T2P_PICK_CANCEL=0
    export T2P_PICK_CANCEL
    case "${_pick}" in
        1|plan)
            t2p_plan
            ;;
        2|apply)
            t2p_apply
            ;;
        9|99|exit|quit|Exit|QUIT)
            ;;
        *)
            return 1
            ;;
    esac
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        return 2
    fi
    return 0
}

# =============================================================================
# app_default() - Interactive numbered menu / off-TTY help
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last updated: 2026-09-02
# =============================================================================
app_default() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    T2P_IN_MENU=1
    export T2P_IN_MENU
    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi
    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET
    while true; do
        app_default_print_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        app_default_run_pick "${_pick}"
        _st=$?
        if [ "${_st}" -eq 2 ]; then
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        if [ "${_st}" -eq 0 ]; then
            return 0
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        out_warn "Not a menu choice. Type 1, 2, 9 to leave, or plan / apply. Next: ${APP_NAME} menu"
    done
}

# =============================================================================
# app_help() - Usage (local Type 0 + domain)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Copy harness docs from a genesis template into a named project}}"
    : "${DESCRIPTION:=POSIX /bin/sh local CLI: apply or plan a harness-docs hop using template-name and project-name.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, plan, apply, list-templates, list-projects, install, uninstall, where-is-me."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "Harness docs (operational):"
    out_plain "  plan <template-name> <project-name>"
    out_plain "                      Show RAM-first roots and folder-backup gate (no writes)"
    out_plain "  apply <template-name> <project-name>"
    out_plain "                      Backup dest, mv dest docs/requirements aside, copy template docs, restore requirements"
    out_plain "  menu                 Numbered list (plan / apply). Alias: main"
    out_plain "                      After plan/apply, TTY lists unspecialized templates then projects; 0 returns to the menu"
    out_empty_line
    out_info "Lifecycle (local self-managed):"
    out_plain "  install              Install ${APP_NAME} (root→global, user→~/.local/bin)"
    out_plain "  install --global     Force global path (${GLOBAL_BIN}; needs write/root)"
    out_plain "  uninstall            Remove managed binary (confirm or --force)"
    out_plain "  where-is-me          Show running and install paths"
    out_plain "  version              Show local version"
    out_plain "  about                Show diagnostics plus RAM/projects roots"
    out_plain "  help                 Show this help"
    out_empty_line
    out_info "Test-purpose commands:"
    out_plain "  list-templates       Numbered unspecialized kits (0 REQs, no incidents, no tests; no writes)"
    out_plain "  list-projects        Numbered dest candidates: current folder and ${PROJECTS_ROOT}"
    out_empty_line
    out_info "Global Options:"
    out_plain "  --template NAME      template-name (genesis-template or subclass)"
    out_plain "  --project NAME       project-name (dest workspace)"
    out_plain "  --dry-run            apply becomes plan"
    out_plain "  --quiet, -q          Suppress info/success (errors still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Skip apply / uninstall confirm"
    out_plain "  --global             Install to GLOBAL_BIN"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line
    out_info "Environment:"
    out_plain "  T2P_RAM_ROOT         RAM-drive parent (default /dev/shm)"
    out_plain "  PROJECTS_ROOT        Hard-disk projects parent (default \${HOME}/prjs)"
    out_plain "  USER_BIN / GLOBAL_BIN  install destinations"
    out_empty_line
    out_info "Examples:"
    out_plain "  ${APP_NAME} apply sh-cli-template grok-cli"
    out_plain "  ${APP_NAME} plan --template genesis-template --project tmpl-to-prj"
    out_plain "  ${APP_NAME} apply --force --template sh-cli-template --project grok-cli"
    out_plain "  ${APP_NAME} list-templates"
    out_plain "  ${APP_NAME} list-projects"
    out_plain "  ${APP_NAME} install"
    out_empty_line
    out_info "Interactive empty argv shows the numbered menu. After plan or apply, pick an unspecialized template (0 requirement files, no incident bodies, no product tests) then a project. Type 0 (or 9 when the list is short) to return to the main menu. Off-TTY empty argv shows help."
    out_info "Optional extra: sudo folder-backup backup TEMPLATE_ROOT (dest is backed up by apply when the gate passes)."
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for tmpl-to-prj. Interactive empty argv = main menu.
# Off-TTY empty argv = help. Domain: plan / apply / menu.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${DRY_RUN:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=tmpl-to-prj}"
    : "${PROJECTS_ROOT:=${HOME}/prjs}"
    : "${T2P_RAM_ROOT:=/dev/shm}"
    : "${TEMPLATE_NAME:=}"
    : "${PROJECT_NAME:=}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    : "${TTY:=0}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    if [ $# -eq 0 ]; then
        if [ "${TTY}" -eq 1 ]; then
            app_default
        else
            app_help
        fi
        return 0
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --dry-run)  DRY_RUN=1; export DRY_RUN ;;
            --template)
                shift
                [ $# -gt 0 ] || out_die "--template needs a template-name. Next: ${APP_NAME} apply --template NAME --project NAME"
                TEMPLATE_NAME="$1"
                export TEMPLATE_NAME
                ;;
            --project)
                shift
                [ $# -gt 0 ] || out_die "--project needs a project-name. Next: ${APP_NAME} apply --template NAME --project NAME"
                PROJECT_NAME="$1"
                export PROJECT_NAME
                ;;
            version|about|help|install|uninstall|where-is-me|plan|apply|menu|main|list-templates|list-projects)
                COMMAND="$1"
                ;;
            *)
                if [ "${COMMAND}" = "plan" ] || [ "${COMMAND}" = "apply" ]; then
                    if [ -z "${TEMPLATE_NAME}" ]; then
                        TEMPLATE_NAME="$1"
                        export TEMPLATE_NAME
                    elif [ -z "${PROJECT_NAME}" ]; then
                        PROJECT_NAME="$1"
                        export PROJECT_NAME
                    else
                        out_die "Unknown extra argument: $1. Next: '${APP_NAME} help'."
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} template=${TEMPLATE_NAME} project=${PROJECT_NAME}"

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_local_install ;;
        uninstall)    inst_local_uninstall ;;
        where-is-me)  app_where_is_me ;;
        plan)            t2p_plan ;;
        apply)           t2p_apply ;;
        menu|main)       app_default ;;
        list-templates)  t2p_cmd_list_templates ;;
        list-projects)   t2p_cmd_list_projects ;;
        help|*)          app_help ;;
    esac
}


# =============================================================================
# t2p_ensure_names() - template-name then project-name
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-cli-interface.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_ensure_names() {
    : "${TEMPLATE_NAME:=}"
    : "${PROJECT_NAME:=}"
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    T2P_PICK_CANCEL=0
    export T2P_PICK_CANCEL
    if [ -z "${TEMPLATE_NAME}" ] && [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
        if ! t2p_pick_template; then
            return 1
        fi
    fi
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        return 1
    fi
    if [ -z "${PROJECT_NAME}" ] && [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
        if ! t2p_pick_project; then
            return 1
        fi
    fi
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        return 1
    fi
    if [ -z "${TEMPLATE_NAME}" ] || [ -z "${PROJECT_NAME}" ]; then
        out_die "template-name and project-name are required. Next: ${APP_NAME} apply <template-name> <project-name> (TTY menu also lists templates and projects by number)"
    fi
    return 0
}

# =============================================================================
# t2p_preflight() - Resolve both roots; set T2P_SRC_ROOT / T2P_DST_ROOT
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_preflight() {
    : "${APP_NAME:=tmpl-to-prj}"
    if ! t2p_ensure_names; then
        return 1
    fi
    if ! t2p_resolve_root "${TEMPLATE_NAME}"; then
        out_die "template-name '${TEMPLATE_NAME}' was not found as a RAM-drive or hard-disk project. Next: create it, or pass an existing directory."
    fi
    T2P_SRC_ROOT="${T2P_RESOLVED_ROOT}"
    T2P_SRC_HOST="${T2P_LAST_HOST_VERSION}"
    if ! t2p_resolve_root "${PROJECT_NAME}"; then
        out_die "project-name '${PROJECT_NAME}' was not found as a RAM-drive or hard-disk project. Next: create it, or pass an existing directory."
    fi
    T2P_DST_ROOT="${T2P_RESOLVED_ROOT}"
    T2P_DST_HOST="${T2P_LAST_HOST_VERSION}"
    export T2P_SRC_ROOT T2P_SRC_HOST T2P_DST_ROOT T2P_DST_HOST
    if t2p_refuse_path "${T2P_SRC_ROOT}"; then
        out_die "template root is a refused path. Next: name a project folder, not home or /."
    fi
    if t2p_refuse_path "${T2P_DST_ROOT}"; then
        out_die "project root is a refused path. Next: name a project folder, not home or /."
    fi
    if [ "${T2P_SRC_ROOT}" = "${T2P_DST_ROOT}" ]; then
        out_die "template-name and project-name resolved to the same folder. Next: pick two different names."
    fi
    if ! t2p_is_genesis_shaped "${T2P_SRC_ROOT}"; then
        out_die "template '${TEMPLATE_NAME}' is not a genesis-template (or subclass) kit (needs docs/, 0 requirement-*.md, no incident bodies, no product tests). Next: pick an unspecialized kit."
    fi
    if ! t2p_is_project_shaped "${T2P_DST_ROOT}"; then
        out_die "project '${PROJECT_NAME}' does not look like a project root (needs docs/ or AGENTS.md). Next: run from a specialized workspace."
    fi
    t2p_folder_backup_gate
}

# =============================================================================

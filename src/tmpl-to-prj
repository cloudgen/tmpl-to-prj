# =============================================================================
# app_default_run_self_leaf() - Run one self-management verb
# =============================================================================
# Returns 0 after a listed leaf. Returns 1 when the pick is not a leaf.
# 81 / install is reserved and is not a leaf. where-is-me is not on this board.
# =============================================================================
app_default_run_self_leaf() {
    _leaf="${1-}"
    case "${_leaf}" in
        82|version)
            app_version
            ;;
        83|about)
            app_about
            ;;
        84|version-check)
            ver_check
            ;;
        85|self-update)
            inst_self_update
            ;;
        86|self-uninstall)
            inst_self_uninstall
            ;;
        87|self-install)
            inst_self_install
            ;;
        *)
            unset _leaf
            return 1
            ;;
    esac
    unset _leaf
    return 0
}

# =============================================================================
# app_default_self_loop() - Self-management layer
# =============================================================================
# A finished leaf returns so the front board redisplays. 0 / back / empty
# returns to the front board. A bad pick reprints this layer. EOF returns.
# =============================================================================
app_default_self_loop() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_default_print_self_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            unset _pick
            return 0
        fi
        case "${_pick}" in
            0|back|Back|"")
                unset _pick
                return 0
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_self_leaf "${_pick}"; then
            unset _pick
            return 0
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        out_error "Not a menu choice '${_pick}'. Type 82-87, 0 back, or a listed command name."
    done
}

# =============================================================================
# app_default_run_pick() - Run one main-menu choice
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-03
# =============================================================================
app_default_run_pick() {
    _pick="${1:-}"
    T2P_PICK_CANCEL=0
    export T2P_PICK_CANCEL
    case "${_pick}" in
        1|plan)
            t2p_plan
            ;;
        2|apply)
            t2p_apply
            ;;
        9|99|exit|quit|Exit|QUIT)
            return 3
            ;;
        *)
            return 1
            ;;
    esac
    if [ "${T2P_PICK_CANCEL:-0}" -eq 1 ]; then
        return 2
    fi
    return 0
}

# =============================================================================
# app_default() - Interactive numbered menu / off-TTY help
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last updated: 2026-09-02
# =============================================================================
app_default() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    T2P_IN_MENU=1
    export T2P_IN_MENU
    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi
    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET
    while true; do
        app_default_print_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT|"")
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
            8|self-management)
                if app_default_self_loop; then
                    JSON=0
                    QUIET=0
                    export JSON QUIET
                    continue
                fi
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_self_leaf "${_pick}"; then
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        app_default_run_pick "${_pick}"
        _st=$?
        if [ "${_st}" -eq 3 ]; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        if [ "${_st}" -eq 2 ] || [ "${_st}" -eq 0 ]; then
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        out_error "Not a menu choice '${_pick}'. Type 1, 2, 8, 9 to leave, or a listed command name."
    done
}


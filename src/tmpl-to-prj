# =============================================================================
# t2p_plan() - Dry-run (no dest writes)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-10
# =============================================================================
t2p_plan() {
    if ! t2p_preflight; then
        t2p_return_to_menu_if_cancelled || true
        return 0
    fi
    t2p_report_resolve
    if [ "${JSON}" -eq 1 ]; then
        return 0
    fi
    out_info "Plan only: no docs overlay. apply will mv dest specialized docs folders aside (requirements, incidents, checklists, whitelists, housekeeping, reviews), copy template docs, then restore those dest folders."
    if [ "${T2P_FB_GATE}" = "missing" ]; then
        out_warn "Global folder-backup is not installed. apply will skip folder-backup and take a local dest-docs snapshot."
    fi
    if [ "${T2P_FB_GATE}" = "narrow" ]; then
        out_warn "folder-backup exists but this login's sudoers is verb-only backup (no *). apply will fail closed. Next: sibling folder-backup print-sudoers"
    fi
    if [ "${T2P_FB_GATE}" = "unproven" ]; then
        out_warn "$(t2p_msg_no_backup_right) apply will stop before overlay."
    fi
    if [ "${T2P_FB_GATE}" = "pass" ]; then
        if [ "${T2P_FB_ROOT:-0}" -eq 1 ]; then
            out_info "apply will run: $(t2p_folder_backup_bin) backup ${T2P_DST_ROOT}"
        else
            out_info "apply will run: sudo -n $(t2p_folder_backup_bin) backup ${T2P_DST_ROOT}"
        fi
    fi
    out_success "Plan complete (no writes)."
}

# =============================================================================
# t2p_utc_stamp() - Timestamp for aside / snapshot names
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_utc_stamp() {
    date -u +%Y%m%d-%H%M%S 2>/dev/null || date +%Y%m%d-%H%M%S
}

# =============================================================================
# t2p_local_docs_snapshot() - Weaker dest-docs copy when global backup missing
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-02
# =============================================================================
t2p_local_docs_snapshot() {
    _dest="${1:-}"
    _stamp=$(t2p_utc_stamp)
    _snap="${_dest}/.t2p-docs-backup-${_stamp}"
    if [ -d "${_dest}/docs" ]; then
        cp -a "${_dest}/docs" "${_snap}" || out_die "Could not snapshot dest docs. Next: check write access on the project folder."
        T2P_BACKUP_NOTE="local:${_snap}"
        export T2P_BACKUP_NOTE
        out_warn "Local dest-docs snapshot (not a durable /var/backup archive): ${_snap}"
    else
        T2P_BACKUP_NOTE="local:none"
        export T2P_BACKUP_NOTE
    fi
}

# =============================================================================
# t2p_backup_dest() - Global folder-backup or local snapshot
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
# - requirement-shell-sudo-command.md
# - INC-20261004-001
# - INC-20261004-002
#
# Last updated: 2026-10-04
# =============================================================================
t2p_backup_dest() {
    _dest="${1:-}"
    : "${T2P_FB_GATE:=}"
    T2P_BACKUP_NOTE=""
    if [ "${T2P_FB_GATE}" = "narrow" ]; then
        out_die "folder-backup is installed but this login's sudoers is verb-only backup (no *). Next: run sibling folder-backup print-sudoers and install a backup * line at /etc/sudoers.d/${FOLDER_BACKUP_NAME}-${USERNAME}."
    fi
    if [ "${T2P_FB_GATE}" = "unproven" ]; then
        out_die "$(t2p_msg_no_backup_right)"
    fi
    if [ "${T2P_FB_GATE}" = "pass" ]; then
        _bin=$(t2p_folder_backup_bin)
        out_info "Backing up dest with folder-backup: ${_dest}"
        if util_sudo "${_bin}" backup "${_dest}"; then
            T2P_BACKUP_NOTE="folder-backup:${_dest}"
            export T2P_BACKUP_NOTE
            out_success "folder-backup of dest finished."
            return 0
        fi
        out_die "folder-backup backup failed. The gate already passed, so this is not a sudoers argv miss. Next: read the folder-backup error above and re-run apply after that backup succeeds."
    fi
    t2p_local_docs_snapshot "${_dest}"
}

# =============================================================================
# t2p_aside_dir_for() - Storage tmp path for one dest docs/ subdir
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-10
# =============================================================================
t2p_aside_dir_for() {
    _name="${1:-}"
    : "${HOME:=/tmp}"
    : "${EFFECTIVE_STORAGE_DIR:=${HOME}}"
    : "${T2P_OVERLAY_STAMP:=none}"
    printf '%s/t2p-%s-%s' "${EFFECTIVE_STORAGE_DIR}" "${_name}" "${T2P_OVERLAY_STAMP}"
}

# =============================================================================
# t2p_restore_asides() - Put dest specialized docs folders back after overlay fail
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-10
# =============================================================================
t2p_restore_asides() {
    _dst="${1:-}"
    mkdir -p "${_dst}/docs"
    if [ -d "${T2P_ASIDE_PATH:-}" ]; then
        rm -rf "${_dst}/docs/requirements"
        mv "${T2P_ASIDE_PATH}" "${_dst}/docs/requirements" 2>/dev/null || true
    fi
    for _name in incidents checklists whitelists housekeeping reviews; do
        _aside=$(t2p_aside_dir_for "${_name}")
        if [ -d "${_aside}" ]; then
            rm -rf "${_dst}/docs/${_name}"
            mv "${_aside}" "${_dst}/docs/${_name}" 2>/dev/null || true
        fi
    done
}

# =============================================================================
# t2p_overlay_docs() - mv specialized dest docs folders aside, replace docs, restore
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-10
# =============================================================================
t2p_overlay_docs() {
    _src="${1:-}"
    _dst="${2:-}"
    : "${HOME:=/tmp}"
    : "${EFFECTIVE_STORAGE_DIR:=${HOME}}"
    T2P_OVERLAY_STAMP=$(t2p_utc_stamp)
    T2P_ASIDE_PATH="${EFFECTIVE_STORAGE_DIR}/t2p-requirements-${T2P_OVERLAY_STAMP}"
    export T2P_ASIDE_PATH T2P_OVERLAY_STAMP EFFECTIVE_STORAGE_DIR
    if [ -d "${_dst}/docs/requirements" ]; then
        mv "${_dst}/docs/requirements" "${T2P_ASIDE_PATH}" || out_die "Could not move dest docs/requirements aside. Next: check write access."
        out_info "Moved dest docs/requirements aside: ${T2P_ASIDE_PATH}"
    fi
    for _name in incidents checklists whitelists housekeeping reviews; do
        if [ -d "${_dst}/docs/${_name}" ]; then
            _aside=$(t2p_aside_dir_for "${_name}")
            mv "${_dst}/docs/${_name}" "${_aside}" || out_die "Could not move dest docs/${_name} aside. Next: check write access."
            out_info "Moved dest docs/${_name} aside: ${_aside}"
        fi
    done
    if [ -e "${_dst}/docs" ]; then
        rm -rf "${_dst}/docs" || out_die "Could not remove dest docs after saving specialized dest docs folders. Next: restore from ${T2P_ASIDE_PATH} and ${EFFECTIVE_STORAGE_DIR}/t2p-*-${T2P_OVERLAY_STAMP}."
    fi
    if [ ! -d "${_src}/docs" ]; then
        t2p_restore_asides "${_dst}"
        out_die "Template has no docs/ folder. Dest specialized docs folders were restored when possible."
    fi
    cp -a "${_src}/docs" "${_dst}/docs" || {
        t2p_restore_asides "${_dst}"
        out_die "Could not copy template docs. Dest specialized docs folders were restored when possible."
    }
    mkdir -p "${_dst}/docs"
    rm -rf "${_dst}/docs/requirements"
    if [ -d "${T2P_ASIDE_PATH}" ]; then
        mv "${T2P_ASIDE_PATH}" "${_dst}/docs/requirements" || out_die "Copied template docs but could not restore dest requirements from ${T2P_ASIDE_PATH}."
        out_info "Restored dest docs/requirements."
    fi
    for _name in incidents checklists whitelists housekeeping reviews; do
        _aside=$(t2p_aside_dir_for "${_name}")
        if [ -d "${_aside}" ]; then
            rm -rf "${_dst}/docs/${_name}"
            mv "${_aside}" "${_dst}/docs/${_name}" || out_die "Copied template docs but could not restore dest ${_name} from ${_aside}."
            out_info "Restored dest docs/${_name}."
        fi
    done
}

# =============================================================================
# t2p_apply() - Backup dest, overlay harness docs, keep dest specialized docs folders
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-tmpl-to-prj.md
#
# Last updated: 2026-09-10
# =============================================================================
t2p_apply() {
    : "${FORCE:=0}"
    : "${DRY_RUN:=0}"
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    if [ "${DRY_RUN}" -eq 1 ]; then
        t2p_plan
        return 0
    fi
    if ! t2p_preflight; then
        t2p_return_to_menu_if_cancelled || true
        return 0
    fi
    if [ "${JSON}" -ne 1 ]; then
        t2p_report_resolve
    fi
    if [ "${FORCE}" -ne 1 ]; then
        if ! prompt_yes_no "Replace dest docs from the template (keep dest specialized docs folders)?"; then
            out_die "Apply cancelled. Next: re-run with --force if you meant to skip the confirm."
        fi
    fi
    t2p_backup_dest "${T2P_DST_ROOT}"
    t2p_overlay_docs "${T2P_SRC_ROOT}" "${T2P_DST_ROOT}"
    out_warn "Dest docs/README may still describe the template kit. Next: rebind dest maps (AGENTS.md live inventory) in an agent session."
    if [ "${JSON}" -eq 1 ]; then
        out_json "apply" "" \
            "app" "${APP_NAME}" \
            "template_root" "${T2P_SRC_ROOT}" \
            "project_root" "${T2P_DST_ROOT}" \
            "folder_backup_gate" "${T2P_FB_GATE}" \
            "backup" "${T2P_BACKUP_NOTE}" \
            "dest_requirements" "$(t2p_count_requirements "${T2P_DST_ROOT}")" \
            "dest_incidents" "$(t2p_count_non_readme_files "${T2P_DST_ROOT}/docs/incidents")"
        return 0
    fi
    out_success "Apply complete: harness docs from ${TEMPLATE_NAME} onto ${PROJECT_NAME}; dest specialized docs folders kept."
}


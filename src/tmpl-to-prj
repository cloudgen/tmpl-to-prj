# Last updated: 2026-09-02
# =============================================================================
t2p_for_each_child() {
    _parent="${1:-}"
    [ -n "${_parent}" ] && [ -d "${_parent}" ] || return 0
    for _d in "${_parent}"/*; do
        [ -d "${_d}" ] || continue
        _base="${_d##*/}"
        case "${_base}" in
            .*|lost+found) continue ;;
        esac
        printf '%s\n' "${_base}"
    done
}


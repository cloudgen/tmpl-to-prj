# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-storage.md
#
# Last reviewed: 2026-08-13
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=tmpl-to-prj}"
    : "${VERSION:=1.0.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=tmpl-to-prj}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ -t 1 ] && _interactive="true"

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "ram_root" "${T2P_RAM_ROOT:-/dev/shm}" \
            "projects_root" "${PROJECTS_ROOT:-}" \
            "domain" "tmpl-to-prj"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 lifecycle)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    out_empty_line
    out_info "RAM-drive root:     ${T2P_RAM_ROOT:-/dev/shm}"
    out_info "Projects root:      ${PROJECTS_ROOT:-}"
    out_info "Domain:             copy harness docs (template-name → project-name)"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} menu            → Numbered list (plan / apply)"
    out_info "   ${APP_NAME} apply <template-name> <project-name>"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
}

# =============================================================================
# util_is_termux() / util_is_git_bash() / util_is_windows_cmd()
# util_is_normal_user_only_cli() - command line for normal user only
# =============================================================================
#
# GENERAL PURPOSE:
# Detect Termux, Git Bash, or Windows cmd. On that class, Type 1 (admin
# privilege) and Type 2 (dedicated system user privilege) stay unused.
#
# ALIGNMENT:
# - requirement-shell-termux-ish.md
# - requirement-shell-sudo-command.md
#
# Last updated: 2026-09-06
# =============================================================================
util_is_termux() {
    [ -n "${PREFIX:-}" ] && case "${PREFIX}" in *com.termux*) return 0 ;; esac
    [ -n "${TERMUX_VERSION:-}" ] && return 0
    [ -d /data/data/com.termux/files/usr ] && return 0
    return 1
}

util_is_git_bash() {
    [ -n "${MSYSTEM:-}" ] && case "${MSYSTEM}" in MINGW*|MSYS*|UCRT*|CLANG*) return 0 ;; esac
    _u=$(uname -s 2>/dev/null || echo "")
    case "${_u}" in MINGW*|MSYS*) return 0 ;; esac
    return 1
}

util_is_windows_cmd() {
    util_is_git_bash && return 1
    [ -n "${WSL_DISTRO_NAME:-}" ] && return 1
    _u=$(uname -s 2>/dev/null || echo "")
    case "${_u}" in Linux|Darwin|FreeBSD*|CYGWIN*) return 1 ;; esac
    case "${OS:-}" in Windows_NT) return 0 ;; esac
    case "${ComSpec:-}${COMSPEC:-}" in *[Cc][Mm][Dd].[Ee][Xx][Ee]*) return 0 ;; esac
    return 1
}

util_is_normal_user_only_cli() {
    util_is_termux && return 0
    util_is_git_bash && return 0
    util_is_windows_cmd && return 0
    return 1
}

